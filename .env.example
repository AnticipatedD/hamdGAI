# ==============================================================================
# HAMDGAI ENVIRONMENT PLATFORM CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this configuration template to '.env' inside your active context space.
# Operational parameters must be supplied by the local system administrator.

# Core Engine Target Mappings
ROCM_ENGINE_URL=http://localhost:8000/v1
ROCM_API_KEY=your_secure_rocm_platform_api_token_here
ROCM_MODEL_NAME=Qwen3-Coder-30B-A3B-Instruct

# Runtime Configuration Boundaries
AGENT_MAX_STEPS=20
RAG_TOP_K=5
REQUIRE_APPROVAL_FOR=write,delete,purchase 

#.env file:
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
TOOLBOX_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<toolbox-name>/versions/<version>/mcp?api-version=v1
TOOLBOX_NAME=agent-tools
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Existing settings go here...
# --- Azure Tooling Configurations ---
# Connection string ID for the targeted AI Search instance
AI_SEARCH_CONN_ID=your-ai-search-connection-id-here

# Target Azure Active Directory subscription identifier
AZURE_SUBSCRIPTION_ID=your-azure-subscription-uuid-here

# Agent Runtime Core Settings
ROCM_API_KEY=your_rocm_api_key_here
PROMETHEUS_PORT=9090

# Azure / Toolbox Connectivity Settings
AI_SEARCH_CONN_ID=your_ai_search_connection_id
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-endpoint.openai.azure.com/
